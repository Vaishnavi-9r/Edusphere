# Copy this file to .env. Use the same local-only, URL-safe password in both values.
REDIS_PASSWORD=replace-with-a-long-random-local-password
# Optional: omit REDIS_URL to disable Redis-backed dashboard and student-list caching.
REDIS_URL=redis://:replace-with-a-long-random-local-password@localhost:6379
DASHBOARD_CACHE_TTL_SECONDS=60
STUDENT_CACHE_TTL_SECONDS=60

# Comma-separated frontend origins. Local development defaults to ports 3000 and 5173.
# Set this to the deployed frontend origin(s) in staging/production.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Swagger UI API server origin. Defaults to localhost in development and the
# EduSphere Render staging origin when NODE_ENV=production.
SWAGGER_SERVER_URL=http://localhost:5000

# For Redis Cloud, replace REDIS_URL with the provider's rediss:// connection URL.
# URL-encode reserved characters in the username/password if required.

# Unauthenticated local Redis URL (not used by the password-protected Compose service):
# REDIS_URL=redis://localhost:6379
